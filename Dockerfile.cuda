# syntax=docker/dockerfile:1

# Tesla M40 24GB support: build CTranslate2 from source with Maxwell sm_52 kernels.
# The stock PyPI wheels skip desktop Maxwell (5.0/5.2), so we compile from source
# with sm_52 included alongside modern architectures.

# ---- Stage 1: Build CTranslate2 from source with Maxwell sm_52 support ----
FROM nvidia/cuda:12.6.3-devel-ubuntu24.04 AS ct2-build

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake git build-essential python3 python3-dev python3-pip python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Clone CTranslate2 v4.8.2 (matches the lock file)
RUN git clone --depth 1 --branch v4.8.2 --recursive \
    https://github.com/OpenNMT/CTranslate2.git /ct2

WORKDIR /ct2

# Patch AWQ kernels for sm_52 compatibility (they use FP16 arithmetic requiring sm_53+)
COPY patch-awq-sm52.py /tmp/patch-awq-sm52.py
RUN python3 /tmp/patch-awq-sm52.py \
    src/ops/awq/dequantize_gpu.cu \
    src/ops/awq/gemm_gpu.cu \
    src/ops/awq/gemv_gpu.cu

# Build with Maxwell sm_52 included alongside modern architectures
RUN cmake -B build -DCMAKE_BUILD_TYPE=Release \
    -DWITH_CUDA=ON -DWITH_CUDNN=OFF -DWITH_MKL=OFF \
    -DOPENMP_RUNTIME=COMP \
    -DCUDA_ARCH_LIST="5.2;6.0;6.1;7.0;7.5;8.0;8.6;8.9;9.0" \
    -DBUILD_CLI=OFF \
    && cmake --build build --parallel $(nproc) \
    && cmake --install build

# Build Python wheel
WORKDIR /ct2/python
RUN python3 -m pip install --no-cache-dir --break-system-packages setuptools wheel pybind11
RUN python3 setup.py bdist_wheel && cp dist/*.whl /tmp/

# ---- Stage 2: Dependencies ----
FROM python:3.12-slim-bookworm AS dependencies
ENV PYTHONDONTWRITEBYTECODE=1 PIP_DISABLE_PIP_VERSION_CHECK=1

# Copy the custom CTranslate2 wheel built with sm_52 support
COPY --from=ct2-build /tmp/*.whl /tmp/

# Build the alignment wheel (WhisperX)
COPY packaging/inference/build_alignment.py /build_alignment.py
RUN python /build_alignment.py --output /wheels

# Filter the lock file to exclude ctranslate2 (we install the custom build instead)
COPY packaging/inference/cuda.lock /tmp/runtime.lock
COPY filter-ct2-lock.py /tmp/filter-ct2-lock.py
RUN python3 /tmp/filter-ct2-lock.py /tmp/runtime.lock /tmp/runtime-no-ct2.lock

# Install the custom CTranslate2 (with sm_52 support) first, then the rest
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --no-compile /tmp/*.whl \
    && /opt/venv/bin/pip install --no-cache-dir --no-compile --require-hashes \
       --only-binary=:all: --find-links=/wheels -r /tmp/runtime-no-ct2.lock \
    && /opt/venv/bin/pip check

FROM dependencies AS application
WORKDIR /app
COPY pyproject.toml README.md LICENSE ./
COPY crowbarr ./crowbarr
# Application-only edits invalidate this small wheel, not the inference runtime.
RUN /opt/venv/bin/pip wheel --no-deps --no-build-isolation --wheel-dir /app-wheel .

FROM python:3.12-slim-bookworm AS cuda
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 CROWBARR_IMAGE_VARIANT=cuda \
    CROWBARR_DATA=/config HF_HOME=/config/models/huggingface \
    TORCH_HOME=/config/models/torch NLTK_DATA=/config/models/nltk HOME=/config \
    PATH=/opt/venv/bin:$PATH
ENV NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    LD_LIBRARY_PATH=/opt/venv/lib/python3.12/site-packages/nvidia/cublas/lib
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /config && chown 1000:1000 /config
COPY --from=dependencies /opt/venv /opt/venv
# The refinement add-on installs from this wheel, which PyPI does not host.
COPY --from=dependencies /wheels /opt/crowbarr/wheels
# Bind the wheel from the builder so neither sources nor wheel archives ship.
RUN --mount=type=bind,from=application,source=/app-wheel,target=/app-wheel \
    pip install --no-cache-dir --no-compile --no-deps /app-wheel/*.whl && pip check
USER 1000:1000
EXPOSE 8449
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8449/health', timeout=3)"
ENTRYPOINT ["crowbarr"]
